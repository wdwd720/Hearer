# Hearer environment configuration. Copy this file to `.env` and edit.
# `.env` is gitignored — do NOT commit secrets.

# OpenAI-compatible provider (used by the server-side LLM brain).
# Leave OPENAI_API_KEY empty to keep Hearer in rule-based mode (no LLM call).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REASONING_MODEL=gpt-4.1-mini

# Master switch. Hearer's LLM features only run when this is "true" AND a
# key is configured. Default: off — the app works fully offline without it.
HEARER_LLM_ENABLED=false

# Server-side guard rails.
HEARER_LLM_TIMEOUT_MS=12000
HEARER_LLM_MAX_INPUT_CHARS=4000

# Privacy: by default Hearer summarises text into structured memory and does
# NOT keep raw transcripts. Set to "true" only if you really want to keep
# the full text on disk. Audio is never uploaded.
HEARER_STORE_RAW_TRANSCRIPTS=false

# Memory API server bind. Default localhost:8788.
# HEARER_API_PORT=8788
# HEARER_API_HOST=0.0.0.0
